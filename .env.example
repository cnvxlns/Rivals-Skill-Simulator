# docker compose용 예시. 실제 값은 .env로 복사해서 채운다(.env는 git에 올리지 않는다).

# Cloudflare Zero Trust 대시보드에서 발급한 터널 토큰.
# docker-compose.tunnel.yml을 쓸 때만 필요하다.
TUNNEL_TOKEN=

# CORS 허용 출처(쉼표 구분). 개인 서버로 노출하면 터널 도메인을 반드시 추가한다.
#
# 주의: 위 문장은 백엔드 기본값(application.properties) 이야기다. docker compose는
# 이 값이 비어 있으면 http://localhost:8081 하나만 넘긴다. NCP처럼 app(nginx)을
# 같이 띄우지 않는 구성에서는 반드시 채운다. 비워두면 앱 전체가 CORS로 막힌다.
#   APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://api.내도메인.com
APP_CORS_ALLOWED_ORIGINS=

# 계정과 덱을 담는 Postgres. 비워두면 개발용 기본값(skillsim)이 쓰인다.
# 개인 서버에 올릴 때는 반드시 바꾼다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 서명 키. HS256이라 32바이트 이상이어야 한다.
# 비워두면 부팅 때 임의 키를 만들고 경고를 남긴다. 개발은 되지만 재시작할 때마다
# 로그인이 풀리므로 개인 서버에서는 반드시 채운다.
#   openssl rand -base64 48
# make up / make up-d는 .env에 이 값이 비어 있으면 위 명령으로 한 번 채워 준다.
# 이미 값이 있으면 건드리지 않으므로 개인 서버 키를 덮어쓸 걱정은 없다.
APP_JWT_SECRET=

# --- NCP 서버 배포 전용 (docker-compose.ncp.yml) -----------------------------
# 로컬 개발에는 필요 없다. 서버의 .env에만 채운다.

# GitHub Actions가 NCR에 올린 백엔드 이미지. 되돌릴 때는 커밋 태그로 바꾼다.
#   BACKEND_IMAGE=myreg.kr.ncr.ntruss.com/skillsim-backend:latest
BACKEND_IMAGE=

# Caddy가 인증서를 받을 도메인. A레코드가 이 서버의 공인 IP를 가리켜야 한다.
API_DOMAIN=

# Let's Encrypt 만료 경고를 받을 주소.
ACME_EMAIL=
