# docker compose용 예시. 실제 값은 .env로 복사해서 채운다(.env는 git에 올리지 않는다).

# Cloudflare Zero Trust 대시보드에서 발급한 터널 토큰.
# docker-compose.tunnel.yml을 쓸 때만 필요하다.
TUNNEL_TOKEN=

# ngrok authtoken과 고정 dev 도메인. docker-compose.ngrok.yml을 쓸 때만 필요하다.
# 토큰은 dashboard.ngrok.com의 Your Authtoken, 도메인은 Domains 화면에 있다.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# CORS 허용 출처(쉼표 구분). Vercel처럼 다른 오리진에서 부르는 프론트를 반드시 넣는다.
# 백엔드 단독 기본값은 http://localhost:8081,https://*.vercel.app 이지만, docker compose는
# 이 값이 비어 있으면 http://localhost:8081 하나만 넘긴다. 서버에서는 비워 두지 않는다.
#   APP_CORS_ALLOWED_ORIGINS=https://rivals-skill-simulator.vercel.app,https://*.vercel.app
APP_CORS_ALLOWED_ORIGINS=

# 계정과 덱을 담는 Postgres. 비워두면 개발용 기본값(skillsim)이 쓰인다.
# 개인 서버에 올릴 때는 반드시 바꾼다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 서명 키. HS256이라 32바이트 이상이어야 한다.
# 비워두면 부팅 때 임의 키를 만들고 경고를 남긴다. 개발은 되지만 재시작할 때마다
# 로그인이 풀리므로 개인 서버에서는 반드시 채운다.
#   openssl rand -base64 48
# make up / make up-d는 .env에 이 값이 비어 있으면 위 명령으로 한 번 채워 준다.
# 이미 값이 있으면 건드리지 않으므로 개인 서버 키를 덮어쓸 걱정은 없다.
APP_JWT_SECRET=
