# OS junk
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Root build artifacts
build/

# Backend (Spring Boot / Gradle)
skill-sim-project/backend/.gradle/
skill-sim-project/backend/build/
skill-sim-project/backend/out/
skill-sim-project/backend/*.db
skill-sim-project/backend/simulator.db
skill-sim-project/backend/*.log
skill-sim-project/backend/.idea/

# App (Expo React Native)
# 세부 규칙은 skill-sim-project/app/.gitignore 참고.
skill-sim-project/app/.idea/

# Working docs / internal assets (planning notes, recordings)
# 데이터 원천과 변환기는 추적한다. CSV는 파생물이라 원본이 없으면 복구가 불가능하다
# (블랙 스킬 레벨은 화면 녹화 판독으로 복원해야 했다). 나머지 docs/는 계속 제외.
skill-sim-project/docs/*
!skill-sim-project/docs/skillsim_logics.json
!skill-sim-project/docs/rivals_skills.xlsx
!skill-sim-project/docs/convert_xlsx.py
!skill-sim-project/docs/test_convert_xlsx.py
!skill-sim-project/docs/score_effects_manual_review.csv

# Python (data-conversion scripts under docs/)
__pycache__/
*.py[cod]

# Environment files
.env
.env.*
!.env.example
