# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# real values. Paths are resolved relative to the project root (the `android/` folder).
#
# Generate a keystore with:
#   keytool -genkey -v -keystore rivals-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias rivals
#
storeFile=rivals-release.jks
storePassword=CHANGE_ME
keyAlias=rivals
keyPassword=CHANGE_ME
